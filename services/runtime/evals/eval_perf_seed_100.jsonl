{"difficulty": "medium", "expected_category": null, "expected_faq_ids": [], "expected_route": "not_scored", "history": [], "id": "perf_real_028", "must_include": [], "must_not_include": [], "query": "// @version=2 // AICoin版本：MACD金叉 \\+ 20日均线策略（吃肉优化版） <br/> // ========== 核心参数 ========== ma\\_period = 20 // 均线周期 macd\\_fast = 12 macd\\_slow = 26 macd\\_signal = 9 vol\\_multiplier = 1\\.2 // 成交量放大倍数 min\\_body\\_ratio = 0\\.3 // 最小实体比例 consolidation\\_bars = 3 // 盘整确认K线数 atr\\_period = 14 // ATR周期 <br/> // ========== 1\\. 核心指标计算 ========== ma20 = ma\\(close, ma\\_period\\) dif = ema\\(close, macd\\_fast\\) \\- ema\\(close, macd\\_slow\\) dea = ema\\(dif, macd\\_signal\\) macd = \\(dif \\- dea\\) \\* 2 <br/> // 成交量分析 volume\\_ma20 = ma\\(volume, 20\\) volume\\_surge = volume &gt; volume\\_ma20 \\* vol\\_multiplier <br/> // K线实体强度分析 body\\_size = abs\\(close \\- open\\) range = high \\- low <br/> // 计算body\\_ratio（避免除零错误） body\\_ratio = 0 if\\(range &gt; 0\\) \\{ body\\_ratio \\:= body\\_size / range \\} <br/> strong\\_body = body\\_ratio &gt; min\\_body\\_ratio bullish\\_body = close &gt; open and strong\\_body <br/> // 趋势强度判断 lowest\\_10 = lowest\\(low, 10\\) highest\\_10 = highest\\(high, 10\\) <br/> trend\\_strength = 0 if\\(highest\\_10 \\- lowest\\_10 &gt; 0\\) \\{ trend\\_strength \\:= \\(close \\- lowest\\_10\\) / \\(highest\\_10 \\- lowest\\_10\\) \\* 100 \\} <br/> // ========== 2\\. 手动计算ATR（替代avg\\_true\\_range） ========== // 计算真实波幅TR tr1 = high \\- low tr2 = abs\\(high \\- close\\[1\\]\\) tr3 = abs\\(low \\- close\\[1\\]\\) <br/> // 找出最大值 max\\_tr = tr1 if\\(tr2 &gt; max\\_tr\\) \\{ max\\_tr \\:= tr2 \\} if\\(tr3 &gt; max\\_tr\\) \\{ max\\_tr \\:= tr3 \\} tr = max\\_tr <br/> // 计算ATR（指数移动平均） atr = ema\\(tr, atr\\_period\\) <br/> // ========== 3\\. 关键条件判断 ========== // A\\. MACD金叉（零轴附近最佳） macd\\_golden = dif &gt; dea and dif\\[1\\] &lt;= dea\\[1\\] macd\\_near\\_zero = abs\\(dif\\) &lt; 0\\.02 and abs\\(dea\\) &lt; 0\\.02 // 零轴附近 <br/> // B\\. 价格突破（真突破识别） // 突破力度：收盘价必须显著高于均线 breakout\\_strength = false if\\(ma20 &gt; 0\\) \\{ breakout\\_strength \\:= \\(close \\- ma20\\) / ma20 \\* 100 &gt; 0\\.5 // 突破0\\.5%以上 \\} <br/> // 突破确认：连续3根K线在均线上方 breakout\\_confirmed = close &gt; ma20 and close\\[1\\] &gt; ma20\\[1\\] and close\\[2\\] &gt; ma20\\[2\\] <br/> // C\\. 盘整后突破（吃大肉关键） // 寻找盘整区域：最近N根K线振幅较小 consolidation\\_range = highest\\(high, consolidation\\_bars\\) \\- lowest\\(low, consolidation\\_bars\\) <br/> in\\_consolidation = false if\\(atr &gt; 0\\) \\{ in\\_consolidation \\:= consolidation\\_range &lt; atr \\* 0\\.5 \\* consolidation\\_bars \\} <br/> // 盘整突破：盘整后放量突破 consolidation\\_breakout = in\\_consolidation\\[1\\] and bullish\\_body and volume\\_surge <br/> // ========== 4\\. 入场信号优化 ========== var in\\_position = false var entry\\_price = 0\\.0 var stop\\_loss\\_price = 0\\.0 var trail\\_stop\\_price = 0\\.0 var max\\_price\\_since\\_entry = 0\\.0 <br/> // 核心入场逻辑：三重确认 // 1\\. MACD金叉（零轴附近优先） // 2\\. 价格有效突破20日均线 // 3\\. 成交量放大 \\+ K线实体强势 buy\\_condition\\_1 = macd\\_golden and breakout\\_confirmed buy\\_condition\\_2 = volume\\_surge and bullish\\_body buy\\_condition\\_3 = trend\\_strength &gt; 30 // 避免在超跌反弹中入场 <br/> // 高胜率入场信号（吃大肉机会） high\\_prob\\_entry = buy\\_condition\\_1 and buy\\_condition\\_2 and buy\\_condition\\_3 <br/> // 盘整突破入场（大行情启动点） big\\_move\\_entry = consolidation\\_breakout and close &gt; ma20 <br/> // 最终入场信号 buy\\_signal = \\(high\\_prob\\_entry or big\\_move\\_entry\\) and not in\\_position <br/> // ========== 5\\. 出场策略优化 ========== // A\\. 移动止盈（让利润奔跑） if\\(in\\_position\\) \\{ // 动态跟踪止盈：价格创新高时更新 current\\_high = highest\\(close, 20\\) update\\_trail = false if\\(trail\\_stop\\_price &gt; 0\\) \\{ update\\_trail \\:= current\\_high &gt; trail\\_stop\\_price \\* 1\\.05 \\} else \\{ update\\_trail \\:= true \\} if\\(update\\_trail\\) \\{ trail\\_stop\\_price \\:= current\\_high \\* 0\\.95 // 回撤5%止盈 \\} \\} <br/> // B\\. 多种出场条件 // 1\\. 移动止盈触发 trail\\_stop\\_signal = in\\_position and close &lt; trail\\_stop\\_price <br/> // 2\\. 趋势反转：价格跌破20日均线且MACD死叉 trend\\_reversal = close &lt; ma20 and dif &lt; dea <br/> // 3\\. 盈利保护：盈利超过20%后，回撤超过最大盈利的30% // 计算入场以来的最高价 if\\(in\\_position\\) \\{ if\\(close &gt; max\\_price\\_since\\_entry\\) \\{ max\\_price\\_since\\_entry \\:= close \\} \\} <br/> max\\_profit = 0 if\\(entry\\_price &gt; 0\\) \\{ max\\_profit \\:= \\(max\\_price\\_since\\_entry / entry\\_price\\) \\- 1 \\} <br/> profit\\_protect = false if\\(max\\_profit &gt; 0\\.2 and entry\\_price &gt; 0\\) \\{ profit\\_protect \\:= close / entry\\_price &lt; 1 \\+ max\\_profit \\* 0\\.7 \\} <br/> // 4\\. 紧急止损：入场后最大亏损不超过8% emergency\\_stop = false if\\(entry\\_price &gt; 0\\) \\{ emergency\\_stop \\:= close / entry\\_price &lt; 0\\.92 \\} <br/> // 最终出场信号 sell\\_signal = in\\_position and \\(trail\\_stop\\_signal or trend\\_reversal or profit\\_protect or emergency\\_stop\\) <br/> // ========== 6\\. 状态管理 ========== if\\(buy\\_signal\\) \\{ in\\_position \\:= true entry\\_price \\:= close stop\\_loss\\_price \\:= close \\* 0\\.92 // 初始止损：\\-8% trail\\_stop\\_price \\:= close \\* 0\\.95 // 初始跟踪止盈：\\-5% max\\_price\\_since\\_entry \\:= close \\} <br/> if\\(sell\\_signal\\) \\{ in\\_position \\:= false entry\\_price \\:= 0\\.0 stop\\_loss\\_price \\:= 0\\.0 trail\\_stop\\_price \\:= 0\\.0 max\\_price\\_since\\_entry \\:= 0\\.0 \\} <br/> // ========== 7\\. 交易指令 ========== enterLong\\(buy\\_signal, price='market', amount=1\\) exitLong\\(sell\\_signal, price='market', amount=1\\) <br/> // ========== 8\\. 可视化 ========== // 买入信号 plotText\\(buy\\_signal, title='买入', text='B', refSeries=low, placement='bottom', color='green', fontSize=14\\) <br/> // 不同类型卖出信号 plotText\\(trail\\_stop\\_signal, title='移动止盈', text='TP', refSeries=high, placement='top', color='orange', fontSize=14\\) plotText\\(trend\\_reversal, title='趋势反转', text='EX', refSeries=high, placement='top', color='red', fontSize=14\\) plotText\\(profit\\_protect, title='盈利保护', text='PP', refSeries=high, placement='top', color='blue', fontSize=14\\) <br/> // 关键指标线 plot\\(ma20, title='20日均线', color='blue', lineWidth=2\\) <br/> // 盘整区域标记 plot\\(in\\_consolidation ? highest\\(high, consolidation\\_bars\\) \\: na, title=\"盘整上轨\", color='yellow', lineWidth=1, lineDash=\\[2,2\\]\\) plot\\(in\\_consolidation ? lowest\\(low, consolidation\\_bars\\) \\: na, title=\"盘整下轨\", color='yellow', lineWidth=1, lineDash=\\[2,2\\]\\)", "source": "session", "tags": ["perf", "real_query"], "weight": 1.153}
