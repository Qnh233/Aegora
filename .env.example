# ============================================================
# Aegora centralized configuration
# Copy to .env at repository root. Do not commit real secrets.
# ============================================================

# ---------- Control Plane ----------
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/aegora_control
BOOTSTRAP_ADMIN_USERS=u_console
AUTH_MODE=local
OA_AUTH_ME_URL=http://127.0.0.1:8000/api/oa/me
OA_AUTH_TIMEOUT_SECONDS=3
OA_LOGIN_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RUNNER_BACKEND=gateway
RUNNER_GATEWAY_URL=http://127.0.0.1:5000
RUNNER_GATEWAY_TIMEOUT_SECONDS=30

# Control-plane debug LLM. Both Control Plane and Runtime should use LiteLLM.
LLM_API_KEY=replace-with-litellm-master-key
LLM_MODEL=aegora-chat
LLM_BASE_URL=http://127.0.0.1:4000/v1

# ---------- Runtime ----------
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_CONSOLE_LOG_ENABLED=false
APP_PRODUCT_ID=aicoin
APP_MODE=api
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=1
API_BEARER_TOKEN=
RUN_DB_MIGRATIONS=true

# Central LLM gateway (LiteLLM Proxy).
LLM_GATEWAY_API_KEY=replace-with-litellm-master-key
LLM_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
LLM_GATEWAY_CHAT_MODEL=aegora-chat
LLM_GATEWAY_FAST_MODEL=aegora-fast
LLM_GATEWAY_TIMEOUT_SECONDS=30
LLM_GATEWAY_ENABLE_THINKING=false
LLM_GATEWAY_TRACE_METADATA_ENABLED=true

# LiteLLM Proxy. Provider details stay behind the gateway; applications only use
# the stable aliases above.
LITELLM_MASTER_KEY=replace-with-a-random-master-key
LITELLM_UPSTREAM_API_KEY=replace-with-provider-key
LITELLM_UPSTREAM_BASE_URL=https://gateway.llmgtw.io/v1
LITELLM_UPSTREAM_CHAT_MODEL=openai/deepseek-v4-pro
LITELLM_UPSTREAM_FAST_MODEL=openai/deepseek-v4-flash
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-latest

# Runtime-owned state / RAG store
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=aegora_runtime
PG_USER=aegora
PG_PASSWORD=replace-me
PG_SSLMODE=prefer
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# Runtime reads immutable releases and current governance facts from Control Plane DB.
AGENT_PLATFORM_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/aegora_control

# Optional shared L2 cache. Only immutable release config snapshots are cached;
# mutable status/RBAC/tool/MCP governance facts remain live PostgreSQL reads.
RUNTIME_CONFIG_CACHE_ENABLED=false
RUNTIME_CONFIG_REDIS_URL=redis://127.0.0.1:6379/0
RUNTIME_CONFIG_CACHE_TTL_SECONDS=3600
RUNTIME_CONFIG_CACHE_KEY_PREFIX=aegora:runtime-config:v1
RUNTIME_CONFIG_EVENTS_ENABLED=false
RUNTIME_CONFIG_INVALIDATION_CHANNEL=aegora:runtime-config:events:v1
RUNTIME_CONFIG_EVENT_RETRY_SECONDS=2
RUNTIME_CONFIG_L1_MAX_ENTRIES=256

# MCP process-local connection pool
MCP_SESSION_IDLE_TTL_SECONDS=900
MCP_SESSION_CLEANUP_INTERVAL_SECONDS=60
MCP_SESSION_MAX_SIZE=100
MCP_DISCOVERY_TTL_SECONDS=300

# Embedding / RAG
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_PATH=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_ENABLE_STARTUP_WARMUP=true

# Optional content source
STRAPI_BASE_URL=
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_SECONDS=20

# Skill / Agent loop
SKILLS_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30
AGENT_TOKEN_BUDGET=32000
AGENT_LOOP_MODE=planner
AGENT_ENABLE_LLM_SELF_CHECK=false
AGENT_MAX_PARALLEL_TOOL_CALLS=4

# Data flywheel / reflection jobs
DATA_OPS_LOOP_SLEEP_SECONDS=30
DATA_OPS_SYNC_INTERVAL_MINUTES=60
DATA_OPS_EMBED_INTERVAL_MINUTES=60
DATA_OPS_REFLECTION_INTERVAL_HOURS=168
DATA_OPS_REFLECTION_DAYS=7
DATA_OPS_MIN_CLUSTER_SIZE=2
DATA_OPS_MIN_NEGATIVE_FEEDBACK=1
DATA_OPS_REFLECTION_CLUSTER_MODE=embedding
DATA_OPS_REFLECTION_CLUSTER_THRESHOLD=0.82
DATA_OPS_WRITE_SKILL_DRAFTS=true
DATA_OPS_REFLECTION_DRY_RUN=true

# WeCom long-lived worker (optional)
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_SCENE=
WECOM_AIBOT_PLUG_VERSION=
WECOM_AIBOT_RECONNECT_INTERVAL_MS=1000
WECOM_AIBOT_MAX_RECONNECT_ATTEMPTS=-1
WECOM_AIBOT_HEARTBEAT_INTERVAL_MS=30000
WECOM_AIBOT_REQUEST_TIMEOUT_MS=10000

# Observability
POCOFLOW_DB_ENABLED=true
FILE_LOG_ENABLED=true
INSTANCE_ID=local
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_OTEL_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_RELEASE=local

