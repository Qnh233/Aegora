{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegora.dev/contracts/agent-release.schema.json",
  "title": "Aegora Agent Release",
  "type": "object",
  "required": ["agent", "tools"],
  "properties": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "system_prompt", "channels"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "system_prompt": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "enabled": {"type": "boolean"},
        "visibility": {"enum": ["public", "private"]},
        "owner_user_id": {"type": ["string", "null"]},
        "channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "capability.schema.json"}
    },
    "workflows": {
      "type": "array",
      "items": {"$ref": "capability.schema.json"},
      "default": []
    },
    "permission_snapshot": {"type": "object"},
    "runtime_policy": {"type": "object"}
  },
  "additionalProperties": true
}

